BIND_HOST=0.0.0.0
PORT=3000

# Path to your Firebase Admin SDK service account JSON.
# The backend reads project_id from this file and mints Firestore OAuth tokens automatically.
# Prefer forward slashes on Windows, or leave the value unquoted.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/sam/Downloads/firebase-adminsdk.json
# Alternative explicit name also supported:
# FIREBASE_ADMINSDK_JSON=

FIRESTORE_DATABASE=(default)

# For local development with the Firestore emulator:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Comma-separated CORS allowlist.
ALLOWED_ORIGINS=https://samhithe.dev,http://localhost:3000,http://localhost:3001,http://localhost:5173

# Defaults to weekly; useful to shrink in a staging environment.
LINK_HEALTH_INTERVAL_SECS=604800
